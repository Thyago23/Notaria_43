# ============================================
# Configuración del Backend - Notaría 43
# ============================================

# Base de Datos (PostgreSQL 14+)
DATABASE_URL="postgresql://user:password@localhost:5432/notaria43?schema=public"

# JWT
JWT_SECRET="cambiar-por-un-secreto-seguro-de-al-menos-32-caracteres"
JWT_EXPIRES_IN="24h"

# Servidor
PORT=3000
NODE_ENV="development"

# CORS - Dominio del frontend en Vercel
CORS_ORIGIN="http://localhost:5173"

# SMTP (Notificaciones por correo)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="correo@notaria43.com"
SMTP_PASS="app-password-aqui"
SMTP_FROM="Notaría 43 <correo@notaria43.com>"

# Reintentos de Email
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_DELAY_MS=1000
